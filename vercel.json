{
  "rewrites": [
    {
      "source": "/tours/output/:match*",
      "destination": "https://mania3d-assets.web.app/output/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/client-logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
